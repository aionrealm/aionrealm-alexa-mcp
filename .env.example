# Copy this file to .env and fill in real values for your target environment.
# Never commit .env -- it is already gitignored.

# --- MCP server ---
# Port the MCP server listens on.
PORT=3333

# HTTP path the Streamable HTTP MCP endpoint is served at.
MCP_PATH=/mcp

# Optional shared-secret bearer token required to call this MCP server itself
# (separate from the AionRealm backend's own auth below). Leave unset for
# local development. Set this before exposing the server publicly (e.g. for
# Alexa+ to reach it) so random internet traffic can't invoke ask_aion.
MCP_SERVER_AUTH_TOKEN=

# --- AionRealm backend adapter ---
# Set to "true" to bypass the real AionRealm backend entirely and use the
# built-in mock adapter (see src/adapters/mockAionAdapter.js). Useful for
# Phase 1 development and for the test harness. When AION_BACKEND_URL is
# unset, the mock adapter is used automatically even if this is left blank.
MOCK_AION_BACKEND=false

# Full URL of the narrow AionRealm backend adapter endpoint this MCP server
# calls (local / staging / production). This endpoint does not exist yet in
# the main AionRealm repo -- see README.md "What Phase 2 needs from the
# AionRealm repo" for the exact contract this MCP server expects it to
# implement.
AION_BACKEND_URL=

# Dedicated MCP-integration API key issued by AionRealm for this server to
# authenticate to AION_BACKEND_URL. This must be a narrow, revocable,
# purpose-specific credential -- never a member session token, never a
# Supabase service-role key, never reused from the main AionRealm repo's
# own .env.
AION_BACKEND_API_KEY=

# Timeout (ms) for calls to the AionRealm backend adapter.
AION_BACKEND_TIMEOUT_MS=15000
