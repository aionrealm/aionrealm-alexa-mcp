# Copy this file to .env and fill in real values for your target environment.
# Never commit .env -- it is already gitignored.

# --- MCP server ---
# Port the MCP server listens on.
PORT=3333

# HTTP path the Streamable HTTP MCP endpoint is served at.
MCP_PATH=/mcp

# Shared-secret bearer token required to call this MCP server itself
# (separate from the AionRealm backend's own auth below). REQUIRED: this
# server refuses to start without it, unless MCP_ALLOW_NO_AUTH=true is
# explicitly set (local development only -- see below). Set a long random
# value before exposing this server publicly (e.g. for Alexa+ to reach it)
# so random internet traffic can't invoke ask_aion.
MCP_SERVER_AUTH_TOKEN=

# Explicit, local-development-only opt-out of the MCP_SERVER_AUTH_TOKEN
# requirement above. Must be the exact string "true" (any case) to take
# effect. This server intentionally does NOT infer "development mode" from
# MOCK_AION_BACKEND or from AION_BACKEND_URL being unset -- those describe
# which Aion backend adapter to use, not whether this server's own endpoint
# should accept unauthenticated requests. NEVER set this in a public or
# production deployment.
MCP_ALLOW_NO_AUTH=

# --- AionRealm backend adapter ---
# Set to "true" to bypass the real AionRealm backend entirely and use the
# built-in mock adapter (see src/adapters/mockAionAdapter.js). Useful for
# local development and for the test harness. When AION_BACKEND_URL is
# unset, the mock adapter is used automatically even if this is left blank.
MOCK_AION_BACKEND=false

# Full URL of the narrow AionRealm backend adapter endpoint this MCP server
# calls (local / staging / production). This endpoint now exists and is
# deployed in AionRealm's Production environment -- see README.md
# "Architecture" for the request/response contract this MCP server expects.
# Leave blank to use the local mock adapter instead.
AION_BACKEND_URL=

# Dedicated MCP-integration API key issued by AionRealm for this server to
# authenticate to AION_BACKEND_URL. This must be a narrow, revocable,
# purpose-specific credential -- never a member session token, never a
# Supabase service-role key, never reused from the main AionRealm repo's
# own .env.
AION_BACKEND_API_KEY=

# Timeout (ms) for calls to the AionRealm backend adapter.
AION_BACKEND_TIMEOUT_MS=15000
