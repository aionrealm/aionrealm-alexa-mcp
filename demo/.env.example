# Copy to demo/.env and fill in real values. Never commit .env -- it is
# already covered by the repo's root .gitignore (.env, .env.local match at
# any depth, including demo/).

# Port this demo's local server listens on.
DEMO_PORT=4000

# Set to "true" to run the demo against canned local responses with no
# network calls at all -- for local UI iteration only. Never use this to
# record the actual submission demo video; the submission must show real
# Living Aion responses.
DEMO_MOCK=false

# The live MCP server's Streamable HTTP endpoint (e.g.
# https://<app-runner-url>/mcp). Required unless DEMO_MOCK=true.
MCP_SERVER_URL=

# The same MCP_SERVER_AUTH_TOKEN configured on the live MCP server (see the
# main README's "Environment variables"). This stays server-side only --
# this demo server injects it into the Authorization header on the MCP
# server's behalf; it is never sent to, or embedded in, the browser.
# Required unless DEMO_MOCK=true.
MCP_SERVER_AUTH_TOKEN=
